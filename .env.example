# ==========================================
# Configuração Headless WordPress REST API
# ==========================================

# Base da API REST do WordPress (obrigatório)
# Exemplo: https://www.paraisodotocantins.to.leg.br/wp-json/wp/v2
WORDPRESS_API_URL="https://www.paraisodotocantins.to.leg.br/wp-json/wp/v2"

# URL pública do site (utilizada em canonical, sitemap, RSS e Open Graph)
SITE_URL="http://localhost:3000"

# Tempo em segundos para revalidação incremental (ISR)
REVALIDATE_SECONDS=300

# Segredo compartilhado para webhook de revalidação sob demanda (/api/revalidate)
REVALIDATE_SECRET="camara-paraiso-revalidate-secret-token"

# Credenciais opcionais para endpoints protegidos (Application Passwords)
WP_API_USER=""
WP_API_APP_PASSWORD=""

# Respeito ao Crawl-Delay e concorrência máxima de requisições à API
WP_REQUEST_DELAY_MS=5000
WP_MAX_CONCURRENCY=2

# Analytics opcional
NEXT_PUBLIC_GA_ID=""

# Gemini AI (se habilitado)
GEMINI_API_KEY=""
